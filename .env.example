# Server Port
PORT=3000

# MongoDB Database Connection String (MongoDB Atlas or Local instance)
MONGODB_URI="mongodb://localhost:27017/mediqo"

# JSON Web Token Secret Key for Session Authentication
JWT_SECRET="mediqo_jwt_secret_key_2026_super_secure"

# Client Frontend Application Base URL (for CORS configuration)
CLIENT_URL="http://localhost:5173"

# Gemini AI API Key (Optional: Powers AI Symptom Checker & Health Assistant)
GEMINI_API_KEY="your_gemini_api_key_here"

# Frontend API URL (If deploying frontend separately on Vercel/Netlify)
VITE_API_URL="http://localhost:3000/api"
